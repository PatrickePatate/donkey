# Copy to .env.production and fill in the blanks.
# Used by: docker compose --env-file .env.production -f compose.prod.yaml up -d --build

APP_NAME=Donkey
APP_ENV=production
APP_DEBUG=false
# Public URL of the app, e.g. https://donkey.example.com
APP_URL=
# Generate with: docker compose --env-file .env.production -f compose.prod.yaml run --rm --no-deps -e APP_KEY=x app php artisan key:generate --show
APP_KEY=
# Set to false to close sign-ups (people with a pending invitation can still register)
REGISTRATION_ENABLED=true
# Set to * when a reverse proxy terminates TLS in front of the stack
TRUSTED_PROXIES=*

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_DATABASE=donkey
DB_USERNAME=donkey
DB_PASSWORD=

REDIS_CLIENT=phpredis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Reverb: choose random values. Browsers reach it through /app on APP_URL;
# REVERB_HOST/PORT/SCHEME are how the app containers publish events.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=donkey
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# GitHub App (see README). The private key is mounted from a file on the host.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=/var/www/html/storage/app/private/github-app.pem
GITHUB_APP_PRIVATE_KEY_FILE=./github-app.pem

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=donkey@example.com
MAIL_FROM_NAME=Donkey

# Public hostname routed by Traefik (must match APP_URL)
DONKEY_HOST=
