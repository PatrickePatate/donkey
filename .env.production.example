# Copy to .env.production and fill in the blanks. Everything else has a working default
# (see the ENV lines in the Dockerfile); APP_KEY and the Reverb keys are generated on first start.

# Public URL of the app, e.g. https://donkey.example.com
APP_URL=

# GitHub App (see README). Save its private key as github-app.pem next to compose.prod.yaml.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Mail (invitations, email verification, budget alerts). MAIL_MAILER=log disables sending.
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=donkey@example.com

# Optional
# REGISTRATION_ENABLED=false     # close sign-ups (pending invitations still work)
# DONKEY_PORT=8090               # local port the reverse proxy forwards to (bound on 127.0.0.1)
# DB_PASSWORD=                   # the database is not exposed outside the stack
# GITHUB_APP_PRIVATE_KEY_FILE=./github-app.pem
